{
  "name": "@claude-prism/root",
  "description": "Open-Source AI LaTeX writing workspace",
  "version": "1.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/boshuaiYu/LocalPrism"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm turbo dev --filter=@claude-prism/web --filter=@claude-prism/latex-api",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:windows": "node scripts/build-desktop.mjs",
    "build:desktop:macos": "bash scripts/build-macos.sh",
    "build:desktop:linux": "bash scripts/build-linux.sh",
    "lint": "pnpm exec biome check",
    "lint:fix": "pnpm exec biome check --fix",
    "release": "echo \"To release: git tag v1.0.8 && git push origin main && git push origin v1.0.8\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "husky": "^9.1.7",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "rollup": ">=4.58.0",
      "serialize-javascript": ">=6.0.3",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.0",
      "hono": ">=4.12.7",
      "ws": ">=8.20.1",
      "postcss": ">=8.5.10",
      "uuid": ">=11.1.1"
    }
  }
}
